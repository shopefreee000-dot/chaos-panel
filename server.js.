const http = require("http");
const crypto = require("crypto");

const rooms = new Map();
const clients = new Map();

function page(mode, room = "") {
  return `<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CHAOS PANEL</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090909;color:white;font-family:Arial;padding:20px}
main{max-width:460px;margin:auto}
header{text-align:center;padding:20px;background:#190000;border-bottom:2px solid red}
h1,h2{color:#ff3030}
.card{background:#171717;border:1px solid #552020;border-radius:12px;padding:16px;margin:15px 0}
input,button{width:100%;padding:13px;margin:7px 0;border-radius:8px;background:#222;color:white;border:1px solid #633}
button{cursor:pointer;font-weight:bold}
.red{background:#a00000}
.green{background:#075b32}
.small{color:#aaa;font-size:12px;line-height:1.5}
#effect{display:none;position:fixed;inset:0;background:#500000;align-items:center;justify-content:center;text-align:center;padding:20px}
</style>
</head>
<body>
<header><h1>CHAOS PANEL</h1><p>REMOTE VISUAL CONTROL</p></header>
<main>
<section class="card">
<h2>${mode === "panel" ? "CONTROL PANEL" : "TARGET DEVICE"}</h2>
<p id="status">Memuat...</p>
${mode === "panel" ? `
<label>Nomor WhatsApp target</label>
<input id="number" placeholder="628xxxxxxxxxx" inputmode="tel">
<button class="red" onclick="invite()">BAGIKAN UNDANGAN</button>
<hr>
<button class="red" onclick="send('flash')">EFEK MERAH</button>
<button onclick="send('welcome')">SAPAAN</button>
<button onclick="send('notify')">NOTIFIKASI</button>
<button class="green" onclick="send('stop')">STOP ALL</button>
<p class="small">Nomor digunakan untuk membagikan undangan, bukan untuk memeriksa akun WhatsApp.</p>
` : `
<p>Izinkan koneksi dari panel untuk menerima efek visual di halaman ini.</p>
<button class="green" onclick="approve()">IZINKAN KONEKSI</button>
`}
</section>
</main>
<div id="effect"><div><h2 id="title">CHAOS</h2><p id="msg"></p><button onclick="stopEffect()">TUTUP EFEK</button></div></div>
<script>
const mode=${JSON.stringify(mode)};
const room=${JSON.stringify(room)};
let approved=false;
let last=0;

function status(t){document.getElementById("status").textContent=t}
async function api(path,data){
 const r=await fetch(path,{
  method:"POST",
  headers:{"Content-Type":"application/json"},
  body:JSON.stringify({room,...data})
 });
 return r.json();
}
async function invite(){
 const n=document.getElementById("number").value.replace(/[^0-9]/g,"");
 if(!/^62[0-9]{8,13}$/.test(n)){alert("Periksa format nomor.");return}
 const link=location.origin+"/?mode=target&room="+encodeURIComponent(room);
 location.href="https://wa.me/"+n+"?text="+encodeURIComponent("Undangan CHAOS PANEL. Buka link ini untuk menyetujui koneksi: "+link);
}
async function approve(){
 const r=await api("/api/approve",{});
 if(r.ok){approved=true;status("Koneksi disetujui")}
 else status("Gagal menyetujui koneksi");
}
async function send(value){
 if(!approved){status("Target belum menyetujui koneksi");return}
 const r=await api("/api/send",{value});
 status(r.ok?"Perintah dikirim":"Target belum terhubung");
}
function stopEffect(){document.getElementById("effect").style.display="none"}
function runEffect(value){
 const box=document.getElementById("effect");
 if(value==="stop"){stopEffect();return}
 box.style.display="flex";
 box.style.background=value==="flash"?"#600000":"#090909";
 document.getElementById("title").textContent=
  value==="welcome"?"HALO 👋":value==="notify"?"NOTIFIKASI":"EFEK VISUAL";
 document.getElementById("msg").textContent=
  value==="notify"?"Panel mengirim notifikasi demo.":"Efek visual aktif.";
}
async function poll(){
 try{
  const r=await fetch("/api/poll?room="+encodeURIComponent(room)+"&after="+last);
  const d=await r.json();
  if(d.ok){
   if(d.approved){approved=true;status("TERHUBUNG")}
   if(d.events){
    for(const e of d.events){last=Math.max(last,e.id);if(mode==="target"&&approved)runEffect(e.value)}
   }
  }
 }catch(e){status("Mencoba menghubungkan...")}
 setTimeout(poll,1200);
}
if(mode==="panel"){
 approved=false;
 status("Menunggu target membuka undangan");
}else{
 status("Belum terhubung — tekan Izinkan Koneksi");
}
poll();
</script>
</body>
</html>`;
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, "http://localhost");
  res.setHeader("X-Content-Type-Options", "nosniff");

  if (req.method === "GET" && url.pathname === "/") {
    let mode = url.searchParams.get("mode") === "target" ? "target" : "panel";
    let room = url.searchParams.get("room") || "";

    if (mode === "panel") {
      room = crypto.randomBytes(18).toString("hex");
      rooms.set(room, { approved: false, events: [], nextId: 1 });
    } else if (!/^[a-f0-9]{36}$/.test(room) || !rooms.has(room)) {
      res.writeHead(404);
      return res.end("Undangan tidak valid atau sudah tidak tersedia.");
    }

    res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
    return res.end(page(mode, room));
  }

  if (req.method === "GET" && url.pathname === "/api/poll") {
    const room = url.searchParams.get("room") || "";
    const state = rooms.get(room);
    if (!state) {
      res.writeHead(404, { "Content-Type": "application/json" });
      return res.end(JSON.stringify({ ok: false }));
    }

    const after = Number(url.searchParams.get("after") || 0);
    res.writeHead(200, { "Content-Type": "application/json", "Cache-Control": "no-store" });
    return res.end(JSON.stringify({
      ok: true,
      approved: state.approved,
      events: state.events.filter(e => e.id > after)
    }));
  }

  if (req.method === "POST" &&
      ["/api/approve", "/api/send"].includes(url.pathname)) {
    let body = "";
    req.on("data", chunk => {
      body += chunk;
      if (body.length > 5000) req.destroy();
    });
    req.on("end", () => {
      let data;
      try { data = JSON.parse(body); } catch {
        res.writeHead(400);
        return res.end('{"ok":false}');
      }

      const state = rooms.get(data.room);
      if (!state) {
        res.writeHead(404, { "Content-Type": "application/json" });
        return res.end('{"ok":false}');
      }

      if (url.pathname === "/api/approve") {
        state.approved = true;
        res.writeHead(200, { "Content-Type": "application/json" });
        return res.end('{"ok":true}');
      }

      if (!state.approved ||
          !["flash", "welcome", "notify", "stop"].includes(data.value)) {
        res.writeHead(403, { "Content-Type": "application/json" });
        return res.end('{"ok":false}');
      }

      state.events.push({ id: state.nextId++, value: data.value });
      state.events = state.events.slice(-30);

      res.writeHead(200, { "Content-Type": "application/json" });
      return res.end('{"ok":true}');
    });
    return;
  }

  res.writeHead(404);
  res.end("Not found");
});

server.listen(process.env.PORT || 10000, "0.0.0.0", () => {
  console.log("CHAOS PANEL is running");
});
